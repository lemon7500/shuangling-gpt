{
  "name": "shuangling-gpt-pet",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "description": "霜铃 GPT：Pets 与 Windows 共用角色素材的本地桌宠",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm --prefix vendor/dsh-pet run bundle && npm --prefix vendor/dsh-pet run build:desktop-core",
    "test": "node --test --test-concurrency=4 tests/bridge/*.test.mjs tests/plugin/*.test.mjs tests/lifecycle/*.test.mjs tests/panel/*.test.mjs",
    "test:plugin": "node --test tests/plugin/*.test.mjs",
    "start": "node windows/start.mjs start",
    "settings": "node windows/start.mjs settings",
    "stop": "node windows/start.mjs stop"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemon7500/shuangling-gpt.git"
  },
  "homepage": "https://github.com/lemon7500/shuangling-gpt#readme",
  "bugs": {
    "url": "https://github.com/lemon7500/shuangling-gpt/issues"
  }
}
